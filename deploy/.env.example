# 仅供本机开发；复制为未提交的 deploy/.env 后应自行更换密码。
# 本机共享基础设施（infra-mysql / infra-redis / infra-qdrant）见
# personal-static-web/deploy/infra/LOCAL_DEV.md：容器走 infra-net 服务别名，宿主机进程走 127.0.0.1。
FORGE_MYSQL_DATABASE=forge_ai
FORGE_MYSQL_USERNAME=forge_ai
FORGE_MYSQL_PASSWORD=local-only-change-me
# 服务器级基础设施网络；生产环境由 /opt/infra 的 Compose 创建。
FORGE_INFRA_NETWORK=infra-net
# 三个独立应用镜像；CI 部署时以 commit SHA 临时覆盖 FORGE_IMAGE_TAG。
FORGE_IMAGE_PREFIX=ghcr.io/yanghheda
FORGE_IMAGE_TAG=latest
# 每个项目必须使用独立 Redis 键前缀和 Qdrant 集合前缀。
FORGE_REDIS_NAMESPACE=forge-ai
FORGE_REDIS_PASSWORD=
# 共享 Qdrant 已开启 api-key 鉴权；启用鉴权的实例必须填写，否则读写返回 401。
# 本地取值见 personal-static-web/deploy/infra/.env 的 QDRANT_API_KEY。
FORGE_QDRANT_API_KEY=
FORGE_QDRANT_COLLECTION_PREFIX=forge_ai_
# compose-test.yml 的宿主机回环端口。
FORGE_TEST_WEB_PORT=13000
# 浏览器侧来源白名单；生产 .env 必须覆盖为实际入口域名（如 https://forgeai.yjxai.cloud）。
FORGE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 独立 GitLab CE 的固定镜像与本机回环端口。
FORGE_GITLAB_IMAGE=gitlab/gitlab-ce:18.4.0-ce.0
FORGE_GITLAB_HTTP_HOST_PORT=8929
FORGE_GITLAB_SSH_HOST_PORT=2224
# 仅写入未提交的 deploy/.env；从 GitLab 项目 Runner 页面新建并复制，泄露后必须轮换。
FORGE_GITLAB_RUNNER_TOKEN=
FORGE_GITLAB_RUNNER_IMAGE=gitlab/gitlab-runner:alpine-v18.4.0
# Server 与 Agent 共享的本机开发签名密钥；真实部署必须替换且不得提交。
FORGE_AGENT_INTERNAL_JWT_SECRET=local-only-change-me-at-least-32-bytes
# 设为 qwen 才会调用百炼；API Key 只写入未提交的 deploy/.env。
FORGE_AGENT_MODEL_PROVIDER=fake
DASHSCOPE_API_KEY=
FORGE_AGENT_QWEN_MODEL=qwen3.8-flash
FORGE_AGENT_QWEN_TIMEOUT_SECONDS=60
FORGE_AGENT_QWEN_MAX_ATTEMPTS=2
FORGE_AGENT_QWEN_RETRY_BACKOFF_SECONDS=0.25
# 32 字节随机值的 Base64；示例仅供本机启动，生产必须通过部署 Secret 注入并备份。
FORGE_SECRET_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
