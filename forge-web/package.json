{
  "name": "@forge-ai/forge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,mjs,ts,json}\"",
    "lint": "eslint src vitest.config.ts vitest.setup.ts",
    "lint:boundaries": "node tests/module-boundaries/check-boundaries.mjs",
