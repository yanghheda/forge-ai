{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-ai.local/schemas/skill.schema.json",
  "title": "ForgeAI Skill Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "allowed_tools", "limits"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls"],
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    }
  }
}

