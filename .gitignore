# 操作系统与编辑器生成文件
.DS_Store
.idea/
.vscode/
*.swp

# 本地配置与 Secret；示例配置允许提交
.env
.env.*
!.env.example
deploy/compose.host-dev.yml
forge-server/src/main/resources/application-local.yml
*.pem
*.key

# Java / Gradle / Maven
.gradle/
build/
target/
forge-server/data/
# 架构测试夹具的包名刻意叫 target（跨模块依赖的反例），必须从构建产物忽略规则里排除，
# 否则该目录不会入库，CI 检出后 BadCrossModuleService 会因缺少 TargetRepository 编译失败。
!forge-server/src/test/java/ai/forge/server/architecture/fixture/cross/target/

# Node.js 与前端构建产物
node_modules/
coverage/
*.tsbuildinfo
playwright-report/
test-results/
blob-report/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# 通用临时产物
*.log
tmp/
dist/
docs/learning/temp.md

.pnpm-store/
data/
